# zkVerify Agent Games — Proof Gatekeeper agent
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# NEVER paste real values into chat, prompts, or git.

# HMAC secret from the Agent Games dashboard ("Rotate Secret").
# Required in production — without it, HMAC verification is OFF.
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key (kurier.xyz dashboard). Without it, proofs are
# generated locally but NOT submitted to Kurier.
KURIER_API_KEY=

# Kurier network: mainnet | testnet (default mainnet)
KURIER_NETWORK=mainnet

# Salt for the gatekeeper circuit input (default 0). Set only if the
# dashboard/practice reveals a per-agent salt.
GATEKEEPER_SALT=0

# Server port
PORT=3000

# Optional overrides
# SEEN_FILE=./data/seen.json
# LOG_FILE=./logs/tasks.log
# PROOF_TIMEOUT_MS=30000
# KURIER_POLL_TIMEOUT_MS=20000
